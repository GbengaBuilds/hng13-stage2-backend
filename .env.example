# Example Environment Variables
# Copy this to .env.development, .env.staging, or .env.production
# and fill in your actual values

ASPNETCORE_ENVIRONMENT=Development

# Database Configuration
MYSQL_ROOT_PASSWORD=your_root_password_here
MYSQL_DATABASE=countrycurrency_dev
MYSQL_USER=appuser_dev
MYSQL_PASSWORD=your_password_here

# API Configuration
API_PORT=8080
DB_PORT=3306

# Connection String
ConnectionStrings__DefaultConnection=Server=db;Port=3306;Database=countrycurrency_dev;User=appuser_dev;Password=your_password_here

# External APIs
EXCHANGE_RATE_API_KEY=your_api_key_here