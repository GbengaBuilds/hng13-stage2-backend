# Database Configuration (for local development with docker-compose)
MYSQLHOST=db
MYSQLPORT=3306
MYSQLDATABASE=countrycurrency
MYSQLUSER=appuser
MYSQLPASSWORD=AppPassword123!

# MySQL Root Password
MYSQL_ROOT_PASSWORD=RootPassword123!

# ASP.NET Core Environment
ASPNETCORE_ENVIRONMENT=Production

# For Railway deployment, use MYSQL_URL format:
# MYSQL_URL=mysql://user:password@host:port/database

# Or individual Railway variables:
# MYSQLHOST=your-railway-host
# MYSQLPORT=3306
# MYSQLDATABASE=railway
# MYSQLUSER=root
# MYSQLPASSWORD=your-railway-password
