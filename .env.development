# Development Environment Variables for GitHub Codespaces
# This file provides default values for the development environment

ASPNETCORE_ENVIRONMENT=Development

# Database Configuration
MYSQL_ROOT_PASSWORD=devroot123
MYSQL_DATABASE=countrycurrency_dev
